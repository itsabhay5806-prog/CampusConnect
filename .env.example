# ========================================================
# CampusConnect - Global Environment Configuration Template
# ========================================================

# Server Configuration
PORT=5001
NODE_ENV=production
CLIENT_URL=https://CampusConnect.vercel.app

# Frontend Configurable API Base URL
# In Vercel full-stack monorepo, leave empty or '/api/v1' for same-origin routing.
# In decoupled deployments, provide full URL (e.g. https://campusconnect-backend.onrender.com/api/v1)
VITE_API_BASE_URL=

# MongoDB Database Configuration (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusconnect?retryWrites=true&w=majority

# JWT Authentication (Required)
JWT_SECRET=super_secure_jwt_secret_key_change_in_production_campusconnect_2026
JWT_EXPIRES_IN=7d

# Cloudinary Storage Configuration (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Institutional Email SMTP Configuration (Optional - supports SMTP_* or EMAIL_* naming)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@campusconnect.edu

# Or use EMAIL_* aliases:
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=

# Development OTP Inspection (Set to false in production)
DEV_OTP_CONSOLE=false
