# ========================================================
# CampusConnect - Global Environment Configuration
# ========================================================

# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Database Configuration
# Provide your hosted MongoDB Atlas connection string here for production.
# If left blank, CampusConnect automatically runs a zero-config in-memory MongoDB instance for development & testing.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusconnect?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secure_jwt_secret_key_change_in_production_campusconnect_2026
JWT_EXPIRES_IN=7d

# Cloudinary Storage Configuration
# Used for profile pictures, post images, and academic PDF attachments.
# If left blank, CampusConnect automatically uses local disk storage (/uploads) with full file validation.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Institutional Email SMTP Configuration
# Required for sending real college-email OTP verification codes and password reset links.
# If left blank in development, CampusConnect prints the OTP to the console and provides an in-app dev helper.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@campusconnect.edu

# Development OTP Inspection
# Set to 'false' in production to disable console logging of verification codes
DEV_OTP_CONSOLE=true
