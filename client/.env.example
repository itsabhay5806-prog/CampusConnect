# ========================================================
# CampusConnect Client - Environment Configuration Template
# ========================================================

# Base URL for Backend API requests
# When deployed together on Vercel as a full-stack monorepo, leave blank or set to /api/v1 (same origin).
# If the backend is deployed to a separate host (e.g. Render/Railway), provide the full URL:
# Example: https://campusconnect-backend.onrender.com/api/v1
VITE_API_BASE_URL=

# Socket.IO Real-Time Server Endpoint (Optional)
# If using a separate persistent backend server for real-time messaging:
# Example: https://campusconnect-backend.onrender.com
VITE_SOCKET_URL=
