# ========================================================
# CampusConnect Server - Environment Configuration Template
# ========================================================

PORT=5001
NODE_ENV=production
CLIENT_URL=https://CampusConnect.vercel.app

# MongoDB Atlas Database Connection URI (Required)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusconnect?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret & Expiration (Required)
JWT_SECRET=super_secure_jwt_secret_key_change_in_production_campusconnect_2026
JWT_EXPIRES_IN=7d

# Cloudinary Storage Configuration (Optional - for persistent image/document attachments)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Institutional Email SMTP Configuration (Optional - supports SMTP_* or EMAIL_* naming)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@campusconnect.edu

# Or use EMAIL_* aliases:
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=

# Set to false in production to disable console logging of OTPs
DEV_OTP_CONSOLE=false
